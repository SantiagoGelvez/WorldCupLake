# API-Football (https://www.api-football.com/) -- v3 API key
API_FOOTBALL_KEY=

# League and season to ingest.
# WC_LEAGUE_ID defaults to 1 (World Cup) if unset.
# WC_SEASON defaults to 2022 if unset.
# WC_LEAGUE_ID=1
# WC_SEASON=2022

# Max API requests one backfill run may spend. The free tier allows 100/day, so this
# leaves headroom for the bootstrap and for manual exploration. Defaults to 30.
# WC_DAILY_BUDGET=30

# Databricks SQL warehouse connection
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Optional overrides. These must match the catalog and schema created by
# ingest/schema/bronze_ddl.sql.
# DATABRICKS_CATALOG=wc_project
# DATABRICKS_SCHEMA=bronze
LOG_LEVEL=INFO
